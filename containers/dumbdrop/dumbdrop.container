# vim: ft=systemd

[Unit]
Description=DumbDrop Container - Public

Requires=var-mnt-media.mount
After=var-mnt-media.mount

[Service]
Restart=on-failure
Environment=DUMBDROP_PORT=3401
EnvironmentFile=%E/containers/systemd/dumbdrop/dumbdrop.env

[Container]
Image=docker.io/dumbwareio/dumbdrop
PublishPort=${DUMBDROP_PORT}:3000
Memory=1g
Volume=/var/mnt/media/drop:${UPLOAD_DIR}

EnvironmentFile=./dumbdrop.env
Environment=ALLOWED_ORIGINS=http://shipyard.lan:${DUMBDROP_PORT},https://drop.zeronet.dimensionzero.net

Secret=dumbdrop-pin,type=env,target=DUMBDROP_PIN

[Install]
WantedBy=default.target
