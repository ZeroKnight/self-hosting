# vim: ft=systemd

[Unit]
Description=Stoat Cron Container

Requires=stoat-db.container stoat-s3.container
After=stoat-db.container stoat-s3.container

[Service]
Restart=on-failure
EnvironmentFile=%E/containers/systemd/stoat/stoat.env

[Container]
Pod=stoat.pod
Image=ghcr.io/stoatchat/crond:v${BACKEND_VERSION}
RunInit=true

Volume=./Revolt.toml:/Revolt.toml:Z
EnvironmentFile=./secrets.env
