# vim: ft=systemd

[Unit]
Description=Back up UpSnap volume data
Before=resticprofile-volumes@backup.service
Before=resticprofile-volumes-b2@backup.service

[Container]
Image=ct-utils.build
Exec=/backup.sh

Volume=./backup.sh:/backup.sh:ro,Z
Volume=%h/backup:/backup:z
Volume=upsnap.volume:/data

[Install]
WantedBy=resticprofile-volumes@backup.service
WantedBy=resticprofile-volumes-b2@backup.service
